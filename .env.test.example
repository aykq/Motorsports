# Local test database (docker-compose.test.yml)
DATABASE_URL=postgresql://ms_test_user:ms_test_password@localhost:5434/motorsports_test

# Required by NextAuth even in dev-login mode
AUTH_SECRET=test-only-secret-do-not-use-in-prod

# Required at module-load time by src/lib/push/index.ts (webpush.setVapidDetails)
# — test-only key pair, never used to actually send a push notification.
VAPID_EMAIL=mailto:test@test.local
VAPID_PUBLIC_KEY=BNlD87Hwg7-DlgkPpWbnDGWeDgUZK-3bFDv1G6wrZ7i_KS4uaE3H4yil5dkA40czni_bmFMys6dVxBMZ-IPL1p0
VAPID_PRIVATE_KEY=LrXiylld-DrFQVJKsJina4kIX1F8FU4uEuNiJsaaavk

# Matches the dev-login form's default email (src/app/(auth)/login/page.tsx:94).
# Note: dev-credentials logins bypass NextAuth's isNewUser detection, so the
# ADMIN_EMAIL auto-promotion in src/lib/auth.ts:154 never fires for them —
# e2e tests pre-seed this user as admin directly (e2e/helpers/auth.ts).
ADMIN_EMAIL=dev@test.com

# Copy this file to .env.test (gitignored) before running tests.

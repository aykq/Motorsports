# Local test database (docker-compose.test.yml)
DATABASE_URL=postgresql://ms_test_user:ms_test_password@localhost:5434/motorsports_test

# Required by NextAuth even in dev-login mode
AUTH_SECRET=test-only-secret-do-not-use-in-prod

# Matches the dev-login form's default email (src/app/(auth)/login/page.tsx:94)
# so the first login auto-promotes to admin (src/lib/auth.ts:154).
ADMIN_EMAIL=dev@test.com

# Copy this file to .env.test (gitignored) before running tests.
